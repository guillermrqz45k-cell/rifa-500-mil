# Rifa 500 Mil — variables de entorno.
# En Railway, DATABASE_URL la pone sola el plugin de Postgres.
# En local, sin DATABASE_URL, se usa SQLite (data/rifa.db).

# URL de Postgres (Railway la inyecta; en local se deja vacía).
DATABASE_URL=

# Puerto del servidor (Railway pone PORT sola).
PORT=3000

# Poner en 'false' solo si el Postgres local no usa SSL.
# En Railway siempre va con SSL.
PGSSL=true

# Archivo SQLite local (solo para pruebas en local).
SQLITE_FILE=data/rifa.db
